# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB (cần replica set để dùng transaction, Atlas mặc định có)
MONGO_URI=mongodb://127.0.0.1:27017/kindercare?replicaSet=rs0

# JWT
JWT_ACCESS_SECRET=doi_chuoi_nay_toi_thieu_32_ky_tu_ngau_nhien
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=doi_chuoi_nay_toi_thieu_32_ky_tu_ngau_nhien_khac
JWT_REFRESH_EXPIRES=7d

# Cookie refresh token. Dev: lax + false. Prod khác domain client/server: none + true
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SePay
SEPAY_WEBHOOK_KEY=
SEPAY_ACCOUNT=
SEPAY_BANK=
SEPAY_ACCOUNT_NAME=

# Log
LOG_LEVEL=info
